---
import status from '../../content/project-status.json';
import MatchingGift from './MatchingGift.astro';
const percent = Math.ceil(status.committed / status.goal * 100);
const millions = (value: number) => `$${Number((value / 1000000).toFixed(2))}M`;
const updated = new Date(`${status.updated}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<section class="project-status" id="project-status" aria-labelledby="project-status-title">
  <div class="container">
    <div class="status-heading">
      <div><p class="eyebrow">Building momentum</p><h2 id="project-status-title">Project Status</h2></div>
      <p class="status-updated">Updated <time datetime={status.updated}>{updated}</time></p>
    </div>
    <div class="status-overview">
      <div class="status-funding">
        <h3>Community fundraising</h3>
        <p class="status-total"><strong>{millions(status.committed)}</strong> committed</p>
        <progress value={status.committed} max={status.goal} aria-label={`${millions(status.committed)} committed toward our ${millions(status.goal)} fundraising goal`}>{percent}%</progress>
        <div class="status-progress-labels"><span>Approximately {percent}% of {millions(status.goal)} goal</span><strong>{millions(status.goal - status.committed)} remaining</strong></div>
        <p class="status-note">The committed total includes a conditional $150,000 foundation pledge. The $150,000 in donor contributions needed to secure it is still to be raised and is not included.</p>
        <a class="button" href="#get-involved">Support the project <span aria-hidden="true">↗</span></a>
      </div>
      <div class="status-construction">
        <p class="eyebrow">Where we are now</p>
        <h3>Excavation complete.<br />Foundations are next.</h3>
        <p>{status.construction}</p>
        <div class="status-event"><span class="eyebrow">Upcoming fundraiser</span><strong>{status.fundraiser.name}</strong><span>{status.fundraiser.date} · {status.fundraiser.time}</span></div>
      </div>
    </div>
    <MatchingGift />
    <div class="status-details">
      <div>
        <h3>Upcoming construction targets</h3>
        <p class="status-note">Target dates are subject to change as construction progresses.</p>
        <ol class="status-timeline">{status.targets.map(item => <li><span>{item.date}</span><strong>{item.label}</strong></li>)}</ol>
      </div>
      <div>
        <h3>Recent milestones</h3>
        <ul class="status-timeline status-completed">{status.milestones.map(item => <li><span>{item.date}</span><strong>{item.label}</strong></li>)}</ul>
        <a class="status-news" href="/news.html">See all project updates <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
<style>
  .project-status { padding-block: 4.5rem; background: var(--muted); }
  .status-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 2rem; }
  .status-heading .eyebrow { color: var(--maroon); margin-bottom: .5rem; }
  .status-heading h2 { margin: 0; }
  .status-updated { font-size: .8125rem; margin: 0 0 .3rem; }
  .status-overview { display: grid; grid-template-columns: 1.1fr 1fr; background: white; border: 1px solid var(--line); }
  .status-funding, .status-construction { padding: 2.5rem; min-width: 0; }
  .status-funding h3 { font: 800 .875rem/1.5 var(--body); margin: 0 0 1rem; }
  .status-total { display: flex; align-items: baseline; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.5rem; }
  .status-total strong { color: var(--maroon); font: 600 clamp(3.5rem, 5vw, 5rem)/1 var(--display); }
  progress { display: block; appearance: none; border: 0; border-radius: 0; width: 100%; height: 14px; background: var(--muted); color: var(--maroon); }
  progress::-webkit-progress-bar { background: var(--muted); }
  progress::-webkit-progress-value { background: var(--maroon); }
  progress::-moz-progress-bar { background: var(--maroon); }
  .status-progress-labels { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; font-size: .8125rem; margin: .75rem 0 1.75rem; }
  .status-progress-labels strong { color: var(--ink); }
  .status-construction { background: var(--navy); color: #d9e3e7; }
  .status-construction .eyebrow { color: var(--gold); margin-bottom: .5rem; }
  .status-construction h3 { color: white; font-size: 2.3rem; margin: 0 0 1rem; }
  .status-construction p:not(.eyebrow) { font-size: .9375rem; }
  .status-event { border-top: 1px solid #ffffff30; padding-top: 1.25rem; }
  .status-event strong, .status-event > span { display: block; }
  .status-event strong { color: white; }
  .status-event > span:last-child { font-size: .875rem; }
  .status-details { display: grid; grid-template-columns: 1.1fr 1fr; gap: 5rem; padding-top: 2.5rem; }
  .status-details h3 { margin: 0 0 .75rem; }
  .status-note { font-size: .8125rem; }
  .status-timeline { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .status-timeline li { position: relative; border-left: 2px solid #c7d4da; padding: 0 0 1.4rem 1.3rem; margin: 0; }
  .status-timeline li:last-child { padding-bottom: 0; }
  .status-timeline li::before { content: ''; position: absolute; left: -6px; top: .45rem; width: 10px; height: 10px; border: 2px solid var(--maroon); background: var(--muted); border-radius: 50%; }
  .status-completed li::before { background: var(--maroon); }
  .status-timeline span, .status-timeline strong { display: block; }
  .status-timeline span { font-size: .75rem; }
  .status-timeline strong { font-size: .9375rem; color: var(--ink); line-height: 1.6; }
  .status-news { display: inline-block; margin-top: 1.5rem; font-size: .875rem; font-weight: 800; padding-block: .5rem; }
  @media (max-width: 760px) {
    .project-status { padding-block: 3rem; }
    .status-heading { display: block; }
    .status-updated { margin-top: .75rem; }
    .status-overview, .status-details { grid-template-columns: 1fr; }
    .status-funding, .status-construction { padding: 1.5rem; }
    .status-details { gap: 2.5rem; }
  }
</style>
